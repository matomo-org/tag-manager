{% macro renderMenuLevel(level1, level2, currentModule, currentAction, dropdownTitle, dropdownItems, dropdownActive = false) %}
    {% set hasSubmenuItem = false %}
    {% set hasActive = false %}
    {% for name, urlParameters in level2 %}
        {% if name|slice(0,1) != '_' %}
            {% set hasSubmenuItem = true %}
            {% set isActive = urlParameters._url.module is defined and urlParameters._url.module == currentModule and urlParameters._url.action is defined and urlParameters._url.action == currentAction %}
            {% set hasActive = hasActive or isActive %}
        {% endif %}
    {% endfor %}

    {% if hasSubmenuItem %}
        <li class="menuTab {% if hasActive %}active{% endif %}" role="menuitem">
            <a class="item" tabindex="5">
                <span class="menu-icon {{ level2._icon|default('icon-chevron-down') }}"></span>{{ level1|translate }}
                <span class="hidden">{{ 'CoreHome_Menu'|translate }}</span>
            </a>
            <ul role="menu">
                {% for name, urlParameters in level2 %}
                    {% if name|slice(0,1) != '_' and urlParameters._url.action is defined and urlParameters._url.action == 'manageContainers' %}
                        {% set isActive = urlParameters._url.module is defined and urlParameters._url.module == currentModule and urlParameters._url.action is defined and urlParameters._url.action == currentAction %}
                        <li {% if isActive %}class="active"{% endif %} role="menuitem">
                            <a class="item{% if urlParameters._cssClass %} {{ urlParameters._cssClass|e('html_attr') }}{% endif %}" tabindex="5" target="_self"
                               title="{{ urlParameters._tooltip|default('')|translate|e('html_attr') }}"
                                {% if urlParameters._onclick is defined and urlParameters._onclick %}
                                    onclick="{{ urlParameters._onclick|e('html_attr') }};return false;"
                                {% endif %}
                                {% if urlParameters._url %}
                                    href="index.php?{{ urlParameters._url|urlRewriteWithParameters|slice(1) }}"
                                {% endif %}>
                                {% if urlParameters._icon is defined and urlParameters._icon %}<span class="icon {{ urlParameters._icon|e('html_attr') }}" style="margin-right: 5px;"></span>{% endif %}
                                {{ name|translate|rawSafeDecoded }}
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}

                {% if dropdownTitle is not empty %}
                    <li role="menuitem" class="tagManagerLeftMenuDropdown {% if dropdownActive %}active{% endif %}">
                        <div
                            vue-entry="CoreHome.MenuItemsDropdown"
                            menu-title="{{ dropdownTitle|e('html_attr') }}"
                            tooltip="{{ dropdownTitle|e('html_attr') }}"
                            show-search="true"
                        >
                            {% for item in dropdownItems %}
                                <a
                                    class="item"
                                    href="{{ item.url|e('html_attr') }}"
                                    title="{{ item.name|e('html_attr') }}"
                                >
                                    {{ item.name }}
                                </a>
                            {% endfor %}
                        </div>
                    </li>
                {% endif %}

                {% for name, urlParameters in level2 %}
                    {% if name|slice(0,1) != '_' and not (urlParameters._url.action is defined and urlParameters._url.action == 'manageContainers') %}
                        {% set isActive = urlParameters._url.module is defined and urlParameters._url.module == currentModule and urlParameters._url.action is defined and urlParameters._url.action == currentAction %}
                        <li {% if isActive %}class="active"{% endif %} role="menuitem">
                            <a class="item{% if urlParameters._cssClass %} {{ urlParameters._cssClass|e('html_attr') }}{% endif %}" tabindex="5" target="_self"
                               title="{{ urlParameters._tooltip|default('')|translate|e('html_attr') }}"
                                {% if urlParameters._onclick is defined and urlParameters._onclick %}
                                    onclick="{{ urlParameters._onclick|e('html_attr') }};return false;"
                                {% endif %}
                                {% if urlParameters._url %}
                                    href="index.php?{{ urlParameters._url|urlRewriteWithParameters|slice(1) }}"
                                {% endif %}>
                                {% if urlParameters._icon is defined and urlParameters._icon %}<span class="icon {{ urlParameters._icon|e('html_attr') }}" style="margin-right: 5px;"></span>{% endif %}
                                {{ name|translate|rawSafeDecoded }}
                            </a>
                            {% if urlParameters._help %}
                                <div vue-entry="CoreHome.ShowHelpLink" name="{{ urlParameters._name }}" message="{{ urlParameters._help|e('html_attr') }}"></div>
                            {% endif %}
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    {% endif %}
{% endmacro %}
